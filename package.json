{
  "name": "edge-llm-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible LLM gateway on Cloudflare Workers",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@cloudflare/workers-types": "5.20261113.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
